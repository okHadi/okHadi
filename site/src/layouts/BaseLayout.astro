---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = Astro.url.pathname } = Astro.props;
const pageTitle = title ? `${title} | Hadi Khan` : 'Hadi Khan — DevOps Engineer & Product Builder';
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL('/og.png', Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Hadi Khan',
  url: new URL('/', Astro.site).href,
  jobTitle: 'DevOps Engineer, Product Builder, and Startup Co-Founder',
  email: 'mailto:hello@mhadi.dev',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Islamabad',
    addressCountry: 'PK',
  },
  sameAs: ['https://github.com/okHadi', 'https://www.linkedin.com/in/okhadi/'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        if (sessionStorage.getItem('portfolio-route-transition') === '1') {
          document.documentElement.classList.add('is-arriving');
          sessionStorage.removeItem('portfolio-route-transition');
        }
      } catch {}
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hadi Khan" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot name="contract" />
    <a class="skip-link" href="#content">Skip to content</a>
    <Header path={Astro.url.pathname} />
    <div id="content"><slot /></div>
    <Footer />
    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      document.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const target = event.target;
        const link = target instanceof Element ? target.closest('a') : null;
        if (!(link instanceof HTMLAnchorElement) || link.target || link.hasAttribute('download')) return;

        const destination = new URL(link.href, window.location.href);
        if (destination.origin !== window.location.origin || destination.protocol !== 'http:' && destination.protocol !== 'https:') return;
        if (destination.pathname === window.location.pathname && destination.search === window.location.search) return;
        if (reducedMotion.matches) return;

        event.preventDefault();
        try { sessionStorage.setItem('portfolio-route-transition', '1'); } catch {}
        document.documentElement.classList.add('is-leaving');
        window.setTimeout(() => window.location.assign(destination.href), 220);
      });

      window.addEventListener('pageshow', () => document.documentElement.classList.remove('is-leaving'));
    </script>
  </body>
</html>
