---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = Astro.url.pathname } = Astro.props;
const pageTitle = title ? `${title} | Hadi Khan` : 'Hadi Khan — DevOps Engineer & Product Builder';
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL('/og.png', Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Hadi Khan',
  url: new URL('/', Astro.site).href,
  jobTitle: 'DevOps Engineer, Product Builder, and Startup Co-Founder',
  email: 'mailto:hello@mhadi.dev',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Islamabad',
    addressCountry: 'PK',
  },
  sameAs: ['https://github.com/okHadi', 'https://www.linkedin.com/in/okhadi/'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hadi Khan" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot name="contract" />
    <a class="skip-link" href="#content">Skip to content</a>
    <Header path={Astro.url.pathname} />
    <div id="content"><slot /></div>
    <Footer />
  </body>
</html>
