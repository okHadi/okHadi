---
interface Props {
  path: string;
}

const { path } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a class="mark" href="/" aria-label="Hadi Khan, home">hk</a>
    <nav aria-label="Primary navigation">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>Work</a>
      <a href="/resume" aria-current={path === '/resume' ? 'page' : undefined}>Resume</a>
      <a href="mailto:hello@mhadi.dev">Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: relative; z-index: 10; border-bottom: 1px solid var(--rule); }
  .site-header::after { content: ''; position: absolute; bottom: -1px; left: 0; width: 9rem; height: 1px; background: var(--signal); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; width: var(--page-width); height: 68px; margin: 0 auto; }
  .mark { color: var(--paper); font-size: 1.35rem; font-weight: 600; letter-spacing: -0.03em; text-decoration: none; }
  nav { display: flex; gap: 28px; align-items: center; }
  nav a { color: var(--paper); font-size: 1rem; text-decoration: none; }
  nav a:hover, nav a:focus-visible, nav a[aria-current='page'] { color: var(--signal); }
  @media (max-width: 640px) {
    .header-inner { height: 60px; }
    nav { gap: 16px; }
  }
</style>
